# =========================================================
# Python
# =========================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# =========================================================
# Secrets and credentials
# =========================================================
.env
.env.*
!.env.example
*.json
!package.json
!tsconfig.json

# Firebase and service-account credentials
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
credentials/
secrets/

# =========================================================
# Sales pipeline source data
# Do not commit municipal, customer, meter, or sales data.
# =========================================================
input/**

# Keep the approved input folder structure in Git
!input/
!input/conlog_sales/
!input/raw-sales/
!input/reference/
!input/received/
!input/prepared/
!input/**/.gitkeep

# =========================================================
# Generated pipeline outputs
# =========================================================
output/**

# Keep the approved output folder structure in Git
!output/
!output/atomic/
!output/logs/
!output/meter_master/
!output/monthly/
!output/monthly_lm/
!output/monthly_lm_groups/
!output/sales_all_meters/
!output/sales_enrich/
!output/**/.gitkeep

# =========================================================
# Logs and temporary files
# =========================================================
*.log
*.tmp
*.temp
~$*
.DS_Store
Thumbs.db

# =========================================================
# IDE and editor files
# =========================================================
.vscode/
.idea/

# =========================================================
# Local backups
# =========================================================
*.bak
*.backup

/node_modules/
/node_modules/

!package-lock.json

# Operational reference CSV archives
archive/*.csv

# Generated Sales All Meters assessment and remediation outputs
scripts/tools/sales-all/reports/

# =========================================================
# Governed local archive
# Historical packages, reports, inspections, outputs and
# extracted artifacts are preserved locally but not committed.
# =========================================================

archive/**
!archive/
!archive/.gitkeep

# =========================================================
# Controlled ZIP exchange
# All repository exchange ZIPs live directly under /zips.
# ZIP payloads remain local and are not committed.
# =========================================================

zips/**
!zips/
!zips/.gitkeep
